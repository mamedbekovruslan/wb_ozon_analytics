{
  "permissions": {
    "allow": [
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(grep:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch --show-current)",
      "Bash(npm test)",
      "Bash(npm run test:e2e)",
      "Bash(npm run lint)",
      "Bash(npm run lint:fsd)",
      "Bash(npm run build)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git reset:*)",
      "Bash(git checkout:*)",
      "Bash(git branch -D:*)",
      "Bash(npm install:*)",
      "Bash(npm i:*)",
      "Bash(npx:*)",
      "Bash(gh:*)",
      "Bash(vercel:*)",
      "Bash(rm:*)",
      "Edit(**/*.test.ts)",
      "Edit(**/*.test.tsx)",
      "Edit(e2e/**)",
      "Write(**/*.test.ts)",
      "Write(**/*.test.tsx)",
      "Write(e2e/**)"
    ],
    "deny": [
      "Read(./.env*)",
      "Bash(cat .env*)"
    ]
  }
}
